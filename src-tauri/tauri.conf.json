{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisp",
  "version": "2.12.18",
  "identifier": "com.whisp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sexyfeifan/Whisp/releases/latest/download/latest.json"
      ],
      "pubkey": "RWSMQDXV/UKkliWsab83mjjMVZhv6rM3QpsFf3wZoiXip0vLS3h3YMsA"
    }
  }
}
